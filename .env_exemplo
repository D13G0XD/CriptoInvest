# ============================================================================
# CriptoInvest - VOLTZ Engenharia de Software
# Modelo de arquivo de credenciais do banco de dados Oracle da FIAP.
#
# COMO USAR:
#   1) copie este arquivo para a raiz do projeto com o nome .env
#   2) troque os valores abaixo pelos seus dados de acesso
#   3) o .env NAO deve ser versionado (ja consta no .gitignore)
#
# A ConnectionFactory procura o .env no diretorio atual e em ate 3 niveis
# acima, ou no caminho indicado por -Denv.file=/caminho/para/.env
#
# Tambem e possivel sobrepor qualquer valor por propriedade de sistema:
#   java -Ddb.user=rmXXXXXX -Ddb.password=ddmmaa -cp "out;lib/ojdbc8.jar" com.criptoinvest.Main
# ============================================================================

# URL JDBC do servidor Oracle da FIAP
DB_URL = jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL

# Usuario do banco - no padrao FIAP e o RM do aluno (ex.: rm561636)
DB_USER = rmXXXXXX

# Senha do banco - no padrao FIAP e a data de nascimento no formato ddmmaa
DB_PASSWORD = ddmmaa
